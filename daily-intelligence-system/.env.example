# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/daily_intel
DB_USER=daily_intel_user
DB_PASSWORD=change_this_password

# Redis
REDIS_URL=redis://redis:6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram API (Telethon uchun)
TELEGRAM_API_ID=your_api_id
