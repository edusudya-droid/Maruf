BOT_TOKEN=your_bot_token_here
OFFICIAL_CHANNEL_ID=-100xxxxxxxxxx
OFFICIAL_CHANNEL_URL=https://t.me/yourchannel
DB_PASSWORD=strongpasswordhere
DATABASE_URL=postgresql+asyncpg://reach_user:password@db:5432/reach_bot
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SIMILARITY_THRESHOLD=0.90
RETRY_LIMIT=2
MAX_DAILY_ANALYSES=20
MAX_VISIBLE_POSTS=20

# =============================================================
# Telethon (MTProto user client) — views va repost qidirish
# =============================================================
# Bu 3 ta qiymat bo'lmasa bot ishlaydi lekin:
#   - Ko'rishlar soni (views) har doim 0 bo'ladi
#   - Repostlar avtomatik topilmaydi
#
# QAYERDAN OLISH:
#   1. https://my.telegram.org ga kiring
#   2. "API development tools" bo'limini oching
#   3. TELEGRAM_API_ID va TELEGRAM_API_HASH ni ko'chiring
#
# SESSION YARATISH (BIR MARTA):
#   docker-compose run --rm bot python -m infrastructure.telegram.generate_session
#   Chiqgan TELETHON_SESSION= qatorini pastga qo'shing.
#
# MUHIM: Telethon uchun ishlatiladigan Telegram account
#   rasmiy kanalga A'ZO bo'lishi kerak.
#   Repostlar faqat shu account a'zo bo'lgan kanallarda topiladi.
# =============================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION=
